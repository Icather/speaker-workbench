  "样本": [
   {
    "tag": "0105",
    "t": "00:00",
    "start": 0.0,
    "end": 2.46,
    "moss": 1,
    "text": "先对一下今天的议程，就三件事。"
   },
   {
    "tag": "0105",
    "t": "00:02",
    "start": 2.79,
    "end": 5.25,
    "moss": 1,
    "text": "场地和预算先过，最后说报名表。"
   },
   {
    "tag": "0105",
    "t": "00:05",
    "start": 5.59,
    "end": 8.2,
    "moss": 1,
    "text": "尽量半小时结束，大家后面还有课。"
   },
   {
    "tag": "0105",
    "t": "00:08",
    "start": 8.54,
    "end": 11.15,
    "moss": 1,
    "text": "有问题随时打断我，不用等我讲完。"
   },
   {
    "tag": "0105",
    "t": "00:11",
    "start": 11.49,
    "end": 13.94,
    "moss": 1,
    "text": "另外说一句，这次材料费走公账。"
   },
   {
    "tag": "0105",
    "t": "00:14",
    "start": 14.28,
    "end": 16.89,
    "moss": 1,
    "text": "谁先垫了都留好发票，月底一起报。"
   },
   {
    "tag": "0108",
    "t": "00:00",
    "start": 0.0,
    "end": 2.61,
    "moss": 1,
    "text": "上周说的几件事，我们逐条对一下。"
   },
   {
    "tag": "0108",
    "t": "00:02",
    "start": 2.95,
    "end": 4.79,
    "moss": 1,
    "text": "先说报名表，改好了吗？"
   },
   {
    "tag": "0108",
    "t": "00:05",
    "start": 5.12,
    "end": 6.8,
    "moss": 1,
    "text": "看到了，格式没问题。"
   },
   {
    "tag": "0108",
    "t": "00:07",
    "start": 7.14,
    "end": 9.38,
    "moss": 1,
    "text": "联系方式那栏放在最后是对的。"
   }
  ]
 },
 "P002": {
