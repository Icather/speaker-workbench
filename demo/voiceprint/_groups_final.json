    "tag": "0105",
    "t": "00:17",
    "start": 17.23,
    "end": 19.54,
    "moss": 2,
    "text": "场地我问过了，周四下午空着。"
   },
   {
    "tag": "0105",
    "t": "00:19",
    "start": 19.88,
    "end": 21.64,
    "moss": 2,
    "text": "不过要提前一天去登记。"
   },
   {
    "tag": "0105",
    "t": "00:21",
    "start": 21.98,
    "end": 24.44,
    "moss": 2,
    "text": "登记表在我这里，回头我发群里。"
   },
   {
    "tag": "0105",
    "t": "00:24",
    "start": 24.78,
    "end": 26.71,
    "moss": 2,
    "text": "另外钥匙是当天去一楼拿。"
   },
   {
    "tag": "0105",
    "t": "00:27",
    "start": 27.05,
    "end": 29.12,
    "moss": 2,
    "text": "那边管理员四点半就下班了。"
   },
   {
    "tag": "0105",
    "t": "00:29",
    "start": 29.47,
    "end": 30.77,
    "moss": 2,
    "text": "所以别拖到太晚。"
   },
   {
    "tag": "0108",
    "t": "00:12",
    "start": 12.05,
    "end": 14.35,
    "moss": 2,
    "text": "场地确认了，周四两点到四点。"
   },
   {
    "tag": "0108",
    "t": "00:14",
    "start": 14.69,
    "end": 16.3,
    "moss": 2,
    "text": "钥匙要当天去一楼拿。"
   },
   {
    "tag": "0108",
    "t": "00:16",
    "start": 16.64,
    "end": 18.94,
    "moss": 2,
    "text": "我那天下午有课，谁去拿一下？"
   },
   {
    "tag": "0108",
    "t": "00:19",
    "start": 19.28,
    "end": 21.36,
    "moss": 2,
    "text": "拿了以后直接去活动室就行。"
   }
  ]
 },
